@echo off
chcp 65001 >nul
echo ========================================
echo PasswdGen CLI 测试脚本
echo ========================================
echo.

set EXE=cmake-build-debug\PasswdGen.exe

if not exist %EXE% (
    echo 错误: 找不到可执行文件 %EXE%
    echo 请先编译项目
    pause
    exit /b 1
)

echo 1. 显示帮助信息
echo ----------------------------------------
%EXE% --help
echo.

echo 2. 生成16位均衡密码 (权重 25:25:25:25)
echo ----------------------------------------
%EXE% -w 16 25 25 25 25
echo.

echo 3. 生成20位偏向字母的密码 (权重 10:40:40:10)
echo ----------------------------------------
%EXE% -w 20 10 40 40 10
echo.

echo 4. 生成12位纯数字密码 (权重 100:0:0:0)
echo ----------------------------------------
%EXE% -w 12 100 0 0 0
echo.

echo 5. 生成标准密码 (3数字+4小写+4大写+3符号)
echo ----------------------------------------
%EXE% -l 3 4 4 3
echo.

echo 6. 生成纯字母密码 (6小写+6大写)
echo ----------------------------------------
%EXE% -l 0 6 6 0
echo.

echo 7. 生成6位PIN码 (纯数字)
echo ----------------------------------------
%EXE% -l 6 0 0 0
echo.

echo 8. 批量生成5个16位密码
echo ----------------------------------------
for /L %%i in (1,1,5) do (
    echo 密码 %%i: 
    %EXE% -w 16 25 25 25 25
)
echo.

echo ========================================
echo 测试完成！
echo ========================================
pause
